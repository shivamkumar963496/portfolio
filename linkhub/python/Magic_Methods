            transition:0.3s;
        }

        .card:hover{
            transform:translateY(-5px);
            border-color:#38bdf8;
        }

        /* ========================================= */
        /* Headings */
        /* ========================================= */

        .card h2{
            color:#38bdf8;
            margin-bottom:20px;
        }

        .card h3{
