        <!-- ========================================= -->
        <!-- Card 1 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>1. __init__() Method</h2>

            <p>

                <span class="highlight">__init__()</span>
                एक Constructor है जो object create होते ही automatically call होता है।

            </p>

<pre><code>
class Demo:

    def __init__(self):
        print("Constructor Called")

d = Demo()
</code></pre>

            <h3>Internal Working</h3>

<pre><code>
d.__init__()
</code></pre>

            <h3>Output</h3>

<pre><code>
Constructor Called
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 2 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>2. __str__() Method</h2>

            <p>

                Object को print करने पर
                <span class="highlight">__str__()</span>
                method call होता है।

            </p>

<pre><code>
class Demo:

    def __str__(self):
        return "Hello Shivam"

d = Demo()

print(d)
</code></pre>

            <h3>Internal Working</h3>

<pre><code>
d.__str__()
</code></pre>

            <h3>Output</h3>

<pre><code>
Hello Shivam
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 3 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>3. __len__() Method</h2>

            <p>

                Object की length return करने के लिए
                <span class="highlight">__len__()</span>
                method use होता है।

            </p>

<pre><code>
class Demo:

    def __len__(self):
        return 5

d = Demo()

print(len(d))
</code></pre>

            <h3>Internal Working</h3>

<pre><code>
d.__len__()
</code></pre>

            <h3>Output</h3>

<pre><code>
5
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 4 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>4. __add__() Method</h2>

            <p>

                <span class="highlight">+</span>
                operator overload करने के लिए use होता है।

            </p>

<pre><code>
class Number:

    def __init__(self,x):
        self.x = x

    def __add__(self,other):
        return self.x + other.x

n1 = Number(10)
n2 = Number(20)

print(n1 + n2)
</code></pre>

            <h3>Internal Working</h3>

<pre><code>
n1.__add__(n2)
</code></pre>

            <h3>Output</h3>

<pre><code>
30
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 5 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>5. __sub__() Method</h2>

            <p>

                <span class="highlight">-</span>
                operator overload करने के लिए use होता है।

            </p>

<pre><code>
class Number:

    def __init__(self,x):
        self.x = x

    def __sub__(self,other):
        return self.x - other.x

n1 = Number(50)
n2 = Number(20)

print(n1 - n2)
</code></pre>

            <h3>Internal Working</h3>

<pre><code>
n1.__sub__(n2)
</code></pre>

            <h3>Output</h3>

<pre><code>
30
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 6 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>6. __mul__() Method</h2>

            <p>

                <span class="highlight">*</span>
                operator overload करने के लिए use होता है।

            </p>

<pre><code>
class Number:

    def __init__(self,x):
        self.x = x

    def __mul__(self,other):
        return self.x * other.x

n1 = Number(5)
n2 = Number(4)

print(n1 * n2)
</code></pre>

            <h3>Internal Working</h3>

<pre><code>
n1.__mul__(n2)
</code></pre>

            <h3>Output</h3>

<pre><code>
20
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 7 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>7. __truediv__() Method</h2>

            <p>

                <span class="highlight">/</span>
                operator overload करने के लिए use होता है।

            </p>

<pre><code>
class Number:

    def __init__(self,x):
        self.x = x

    def __truediv__(self,other):
        return self.x / other.x

n1 = Number(20)
n2 = Number(5)

print(n1 / n2)
</code></pre>

            <h3>Internal Working</h3>

<pre><code>
n1.__truediv__(n2)
</code></pre>

            <h3>Output</h3>

<pre><code>
4.0
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 8 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>8. __gt__() Method</h2>

            <p>

                <span class="highlight">></span>
                comparison operator overload करने के लिए use होता है।

            </p>

<pre><code>
class Demo:

    def __init__(self,x):
        self.x = x

    def __gt__(self,other):
        return self.x > other.x

d1 = Demo(30)
d2 = Demo(10)

print(d1 > d2)
</code></pre>

            <h3>Output</h3>

<pre><code>
True
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 9 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>9. __lt__() Method</h2>

            <p>

                <span class="highlight"><</span>
                comparison operator overload करने के लिए use होता है।

            </p>

<pre><code>
class Demo:

    def __init__(self,x):
        self.x = x

    def __lt__(self,other):
        return self.x < other.x

d1 = Demo(5)
d2 = Demo(10)

print(d1 < d2)
</code></pre>

            <h3>Output</h3>

<pre><code>
True
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 10 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>10. __eq__() Method</h2>

            <p>

                <span class="highlight">==</span>
                comparison operator overload करने के लिए use होता है।

            </p>

<pre><code>
class Demo:

    def __init__(self,x):
        self.x = x

    def __eq__(self,other):
        return self.x == other.x

d1 = Demo(10)
d2 = Demo(10)

print(d1 == d2)
</code></pre>

            <h3>Output</h3>

<pre><code>
True
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 11 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>11. __call__() Method</h2>

            <p>

                Object को function की तरह callable बनाने के लिए
                use होता है।

            </p>

<pre><code>
class Demo:

    def __call__(self):
        print("Object Called")

d = Demo()

d()
</code></pre>

            <h3>Internal Working</h3>

<pre><code>
d.__call__()
</code></pre>

            <h3>Output</h3>

<pre><code>
Object Called
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 12 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>12. __del__() Method</h2>

            <p>

                Object delete होने पर
                <span class="highlight">__del__()</span>
                method call होता है।

            </p>

<pre><code>
class Demo:

    def __del__(self):
        print("Object Deleted")

d = Demo()
</code></pre>

            <h3>Output</h3>

<pre><code>
Object Deleted
</code></pre>

        </div>

        <!-- ========================================= -->
        <!-- Card 13 -->
        <!-- ========================================= -->

        <div class="card">

            <h2>13. __contains__() Method</h2>

            <p>

                <span class="highlight">in</span>
                operator overload करने के लिए use होता है।

            </p>

<pre><code>
class Demo:

    def __contains__(self,item):
        return item in [1,2,3,4]

d = Demo()

print(2 in d)
</code></pre>

            <h3>Internal Working</h3>

<pre><code>
d.__contains__(2)
</code></pre>

            <h3>Output</h3>

<pre><code>
True
</code></pre>

        </div>

